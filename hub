local function requestAccessToken()
    local key = ""
    local prompted = false
    while true do
        local ok, statusCode, body = postJson(CONFIG.DistributionBaseUrl .. "/v1/token", {
            key = key,
            place_id = PLACE_ID,
            game_id = GAME_ID,
            player_id = PLAYER_ID,
            fingerprint = FINGERPRINT,
            client_version = CONFIG.ClientVersion,
            channel = CONFIG.Channel,
        })
        if ok and statusCode == 200 and type(body) == "table" then
            if body.authorized == true and type(body.token) == "string" then
                return true, body.token
            end
            if body.reason ~= "key_required" then
                return false, tostring(body.error or body.reason or "Access was not authorised.")
            end
        elseif ok and type(body) == "table" and body.reason ~= "key_required" then
            return false, tostring(body.error or body.reason or "Access was not authorised.")
        elseif not ok then
            return false, tostring(body or statusCode or "Access service is unavailable.")
        end

        if prompted then return false, "The access key was not accepted." end
        prompted = true
        local entered, enteredKey = promptAccessKey()
        if not entered then return false, enteredKey end
        key = enteredKey
    end
end

local function download(url, token)
    if type(url) ~= "string" or url == "" or url:find("PASTE_", 1, true) then
        return false, "Distribution endpoint has not been configured."
    end

    local lastError = "unknown API error"
    for attempt = 1, CONFIG.RequestAttempts do
        local ok, statusCode, bodyOrError = postJson(url, {
            token = token,
            place_id = PLACE_ID,
            game_id = GAME_ID,
            player_id = PLAYER_ID,
            fingerprint = FINGERPRINT,
            client_version = CONFIG.ClientVersion,
            channel = CONFIG.Channel,
        })
        if ok and statusCode == 200 and type(bodyOrError) == "table" and bodyOrError.authorized == true and type(bodyOrError.source) == "string" and #bodyOrError.source > 0 then
            return true, bodyOrError.source
        end

        if ok and type(bodyOrError) == "table" then
            lastError = tostring(bodyOrError.error or bodyOrError.reason or ("API status " .. tostring(statusCode)))
        else
            lastError = tostring(statusCode or bodyOrError)
        end
        if attempt < CONFIG.RequestAttempts then task.wait(CONFIG.RetryDelay * attempt) end
    end
    return false, lastError
end

local function runPayload(entry, source)
    if type(loadstring) ~= "function" then
        return false, "loadstring is not available in this executor."
    end

    local compiled, chunk, compileError = pcall(
        loadstring,
        source,
        "=KixHub/" .. tostring(entry.Name)
    )

    if not compiled or type(chunk) ~= "function" then
        return false, "payload compile failed: " .. tostring(compileError or chunk)
    end

    local ran, runtimeError = pcall(chunk)
    if not ran then
        return false, "payload runtime failed: " .. tostring(runtimeError)
    end

    return true
end

local function runWindUI(source)
    if type(loadstring) ~= "function" then
        return false, "loadstring is not available in this executor."
    end

    local compiled, chunk, compileError = pcall(
        loadstring,
        source,
        "=KixHub/WindUI-Better"
    )

    if not compiled or type(chunk) ~= "function" then
        return false, "WindUI compile failed: " .. tostring(compileError or chunk)
    end

    local ran, library = pcall(chunk)
    if not ran or type(library) ~= "table" then
        return false, "WindUI initialisation failed: " .. tostring(library)
    end

    shared.KixHubWindUI = library
    return true
end

-- ============================================================================
-- DISPATCH
-- ============================================================================

local placeId = PLACE_ID
local entry = Games[placeId]
if not entry then
    for _, candidate in pairs(Games) do
        if candidate.GameId and tostring(candidate.GameId) == GAME_ID then
            entry = candidate
            break
        end
    end
end

if not entry then
    updateStatus("Game belum didukung.\nPlaceId: " .. placeId .. "\nGameId: " .. GAME_ID, true)
    warn("[KixHub Loader] Unsupported PlaceId: " .. placeId .. " | GameId: " .. GAME_ID)
    task.delay(4, function()
        if destroyStatus then destroyStatus() end
        release()
    end)
    return
end

local path = CONFIG.Channel == "production"
    and entry.ProductionPath
    or entry.DevelopmentPath
local url = CONFIG.DistributionBaseUrl .. path .. placeId
local windUIPath = CONFIG.Channel == "production"
    and entry.ProductionWindUIPath
    or entry.DevelopmentWindUIPath
local windUIUrl = CONFIG.DistributionBaseUrl .. windUIPath

updateStatus("Loading " .. entry.Name .. "...\nPlaceId: " .. placeId .. "\nGameId: " .. GAME_ID)

updateStatus("Checking access...\n" .. entry.Name)
local accessGranted, accessTokenOrError = requestAccessToken()
if not accessGranted then
    updateStatus(accessTokenOrError, true)
    fail(accessTokenOrError)
    task.delay(5, function()
        if destroyStatus then destroyStatus() end
    end)
    return
end
local accessToken = accessTokenOrError

if type(shared.KixHubWindUI) ~= "table" then
    updateStatus("Loading interface...\n" .. entry.Name)

    local windUIDownloaded, windUISourceOrError = download(windUIUrl, accessToken)
    if not windUIDownloaded then
        updateStatus(windUISourceOrError, true)
        fail(windUISourceOrError)
        task.delay(5, function()
            if destroyStatus then destroyStatus() end
        end)
        return
    end

    local windUIReady, windUIError = runWindUI(windUISourceOrError)
    if not windUIReady then
        updateStatus(windUIError, true)
        fail(windUIError)
        task.delay(5, function()
            if destroyStatus then destroyStatus() end
        end)
        return
    end
end

local downloaded, sourceOrError = download(url, accessToken)
if not downloaded then
    updateStatus(sourceOrError, true)
    fail(sourceOrError)
    task.delay(5, function()
        if destroyStatus then destroyStatus() end
    end)
    return
end

updateStatus("Compiling " .. entry.Name .. "...")

local ran, runError = runPayload(entry, sourceOrError)
if not ran then
    updateStatus(runError, true)
    fail(runError)
    task.delay(5, function()
        if destroyStatus then destroyStatus() end
    end)
    return
end

state.State = "ready"
state.PlaceId = placeId
state.Game = entry.Name

local payloadShutdown = shared.KixHub99NightsShutdown
local retired = false
state.Retire = function(reason)
    if retired then return end
    retired = true

    if type(payloadShutdown) == "function" then
        pcall(payloadShutdown, reason or "shutdown")
    end
    if shared.KixHub99NightsShutdown == payloadShutdown then
        shared.KixHub99NightsShutdown = nil
    end
    if shared[STATE_KEY] == state then
        shared[STATE_KEY] = nil
    end
end

if destroyStatus then
    destroyStatus()
end

-- The payload may call this on shutdown.
shared.KixHubLoaderRelease = function()
    if type(state.Retire) == "function" then
        state.Retire("release")
    else
        release()
    end
end
