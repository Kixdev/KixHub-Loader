local function getRequestFunction()
    if type(request) == "function" then return request end
    if type(http_request) == "function" then return http_request end
    if type(syn) == "table" and type(syn.request) == "function" then return syn.request end
    return nil
end

local requestFunction = getRequestFunction()

local function postJson(url, payload)
    if not requestFunction then
        return false, nil, "This loader requires an executor HTTP request function."
    end
    local lastError = "unknown API error"

    for attempt = 1, CONFIG.RequestAttempts do
        local ok, result = pcall(function()
            local requestBody = HttpService:JSONEncode(payload)
            local response = requestFunction({
                Url = url,
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = requestBody,
                body = requestBody,
            })
            local statusCode = tonumber(response and (response.StatusCode or response.Status or response.status_code)) or 0
            local raw = response and (response.Body or response.body) or ""
            local decoded, body = pcall(HttpService.JSONDecode, HttpService, raw)
            if not decoded or type(body) ~= "table" then
                error("API returned invalid JSON")
            end
            return statusCode, body
        end)

        if ok and type(result) == "table" then
            return true, result[1], result[2]
        end

        lastError = tostring(result)
        if attempt < CONFIG.RequestAttempts then
            task.wait(CONFIG.RetryDelay * attempt)
        end
    end

    return false, nil, lastError
end

