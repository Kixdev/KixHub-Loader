-- KIXHUB Universal Loader
-- Main entry point for game detection, payload routing, and runtime startup.

local CONFIG = {
    -- Set this to the distribution endpoint before publishing.
    DistributionBaseUrl = "https://kixhub-distribution.lirikkuviral.workers.dev",
    Channel = "development",
    ClientVersion = "kixhub-loader/2.0",
    RequestAttempts = 3,
    RetryDelay = 1,
}

local shared = (type(getgenv) == "function" and getgenv()) or _G
local STATE_KEY = "KixHubUniversalLoader"
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local PLACE_ID = tostring(game.PlaceId)
local GAME_ID = tostring(game.GameId)
local PLAYER_ID = LocalPlayer and tostring(LocalPlayer.UserId) or "0"
local FINGERPRINT = tostring(shared.KixHubInstallationId or ("roblox-" .. PLAYER_ID))

-- Session guard.
local previous = shared[STATE_KEY]
if type(previous) == "table" and (previous.State == "loading" or previous.State == "ready") then
    local previousShutdown = shared.KixHub99NightsShutdown
    if type(previousShutdown) == "function" then
        pcall(previousShutdown, "reload")
    end
    if type(previous.Retire) == "function" then
        pcall(previous.Retire, "reload")
    end
    if shared[STATE_KEY] == previous then
        shared[STATE_KEY] = nil
    end
    if shared.KixHub99NightsShutdown == previousShutdown then
        shared.KixHub99NightsShutdown = nil
    end
end

local state = {
    State = "loading",
    StartedAt = os.clock(),
    Retire = nil,
}
shared[STATE_KEY] = state

if type(previous) == "table" and type(previous.Retire) == "function" then
    pcall(previous.Retire)
end

local function release()
    if shared[STATE_KEY] == state then
        shared[STATE_KEY] = nil
    end
end

local function fail(message)
    state.State = "failed"
    warn("[KixHub Loader] " .. tostring(message))
    release()
end

